# ─── Ingestion (Node scripts only) ───────────────────────────────
GITHUB_USERNAME=your-github-handle
GITHUB_TOKEN=ghp_xxx                 # classic PAT, public_repo scope (raises rate limit)
CANDIDATE_NAME=Your Full Name        # used in the persona prompt

# ─── LLM + embeddings ────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx                 # primary LLM (llama-3.3-70b-versatile)
GEMINI_API_KEY=AIza_xxx              # embeddings (text-embedding-004) + fallback + eval judge

# ─── The Brain (auth) ────────────────────────────────────────────
BRAIN_API_TOKEN=generate-a-long-random-string   # bearer shared by Vapi + chat proxy

# ─── Booking (Cal.com → Google Calendar) ─────────────────────────
CALCOM_API_KEY=cal_xxx
CALCOM_EVENT_TYPE_ID=123456          # the interview event type id

# ─── Voice (Vapi) — for eval log fetching / config ───────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# ─── Optional rate limiting (Upstash Redis REST) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Deployment ──────────────────────────────────────────────────
# Public base URL of the deployed app (used by eval script to hit the brain)
APP_BASE_URL=http://localhost:3000
